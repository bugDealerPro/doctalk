# OpenAI-compatible API
OPENAI_API_KEY=sk-your-key-here
# Optional: set for local LLM gateways (Ollama, vLLM, etc.)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Models
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Database (docker-compose overrides host for the app service)
DOCTALK_DATABASE_URL=postgresql://doctalk:doctalk@localhost:5432/doctalk

# Ingestion limits
MAX_PDF_SIZE_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
